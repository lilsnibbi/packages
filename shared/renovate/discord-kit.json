{
  "packageRules": [
    {
      "description": "Keep Discord peer and development versions aligned",
      "matchPackageNames": [
        "discord.js"
      ],
      "rangeStrategy": "bump",
      "addLabels": [
        "discord"
      ]
    },
    {
      "description": "Label logger runtime updates",
      "matchPackageNames": [
        "@lilsnibbi/logger"
      ],
      "rangeStrategy": "bump",
      "addLabels": [
        "runtime"
      ]
    }
  ]
}
