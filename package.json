{
  "name": "lilsnibbi-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "bun scripts/pipeline.ts",
    "typecheck": "bun tsc --noEmit",
    "configs:sync": "bun scripts/sync-configs.ts",
    "configs:check": "bun scripts/sync-configs.ts --check",
    "check": "bun run configs:check && bun run typecheck && bun run pipeline check --project=all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
