{
	"name": "@lilsnibbi/helpers",
	"version": "1.0.1",
	"description": "Small TypeScript helper functions for the Bun runtime.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"LICENSE"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/packages.git",
		"directory": "helpers"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"postpack": "bun ../scripts/license.ts --clean",
		"prepack": "bun ../scripts/license.ts"
	}
}
