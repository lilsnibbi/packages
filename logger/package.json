{
	"name": "@lilsnibbi/logger",
	"version": "1.2.0",
	"description": "Structured console logger for the Bun runtime, with no styling dependency.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"LICENSE"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/packages.git",
		"directory": "logger"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@lilsnibbi/helpers": "workspace:^"
	},
	"scripts": {
		"postpack": "bun ../scripts/license.ts --clean",
		"prepack": "bun ../scripts/license.ts"
	}
}
