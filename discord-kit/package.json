{
	"name": "@lilsnibbi/discord-kit",
	"version": "1.0.1",
	"description": "Client, command, event and pagination structures for discord.js bots on the Bun runtime.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"LICENSE"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/packages.git",
		"directory": "discord-kit"
	},
	"dependencies": {
		"@lilsnibbi/logger": "workspace:^"
	},
	"peerDependencies": {
		"discord.js": "^14.27.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"discord.js": "14.27.0"
	},
	"scripts": {
		"postpack": "bun ../scripts/license.ts --clean",
		"prepack": "bun ../scripts/license.ts"
	}
}
